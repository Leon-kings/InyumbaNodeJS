# ============================================================
# GMAIL SMTP CONFIGURATION — works locally and on Render
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=leonakingeneye2002@gmail.com

# REQUIRED: Gmail App Password, NOT your normal Gmail password.
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create app password:        https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below with no spaces.
SMTP_PASS=

NODE_ENV=production

# ============================================================
# OPTIONAL
# ============================================================

EMAIL_FROM_NAME=INYUMBA

# Address emails are sent FROM. Defaults to SMTP_USER if unset.
ADMIN_EMAIL=leonakingeneye2002@gmail.com

# Default recipient used by sendTestEmail() when no recipient
# is passed in code. Defaults to SMTP_USER if unset.
TEST_EMAIL=kingsleon250@gmail.com

# Set to "true" to have the server send ONE real test email to
# TEST_EMAIL automatically every time it boots up. Useful to
# confirm SMTP is really working on Render vs just verified.
# Leave "false" in normal production use so restarts don't spam.
SEND_TEST_EMAIL_ON_STARTUP=true

# Set to "true" to see verbose SMTP protocol logs
SMTP_DEBUG=false
